<Window x:Class="YTRC.ERP.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Fluent="urn:fluent-ribbon"
        Title="YTRC-ERP" Icon="Assets/YTRC-ERP.ico" Width="1480" Height="960" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="Segoe UI"
        Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#E1E7EF" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#0F766E">
                        <TextBlock Text="Y" Foreground="White" FontSize="19" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="YTRC-ERP" FontSize="18" FontWeight="SemiBold" Foreground="#1E2D3E"
                               VerticalAlignment="Center" Margin="11,0,0,0" />
                </StackPanel>
                <Grid Grid.Column="1" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SearchBox" Height="36" ToolTip="Search departments and work areas"
                             KeyDown="SearchBox_KeyDown" />
                    <Button Grid.Column="1" Content="Search" Margin="8,0,0,0" Click="Search_Click" />
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border x:Name="ConnectionBadge" Background="#F1F5F9" CornerRadius="14" Padding="11,6" Margin="0,0,14,0">
                        <TextBlock x:Name="ConnectionText" Text="API status unknown" FontSize="12" Foreground="#526277" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock x:Name="UserNameText" Text="Guest" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="RoleText" Text="Guest" FontSize="11" Foreground="#68788D" HorizontalAlignment="Right" />
                    </StackPanel>
                    <Button Content="Sign out" Padding="11,7" Click="SignOut_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Fluent:Ribbon x:Name="MainRibbon" Grid.Row="1" SelectedTabChanged="MainRibbon_SelectedTabChanged">
            <Fluent:RibbonTabItem Header="Home" Tag="Home">
                <Fluent:RibbonGroupBox Header="Workspace">
                    <Fluent:Button Header="Dashboard" Tag="Dashboard" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Quick Actions">
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Insights">
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Export" Tag="Export" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="QA" Tag="QA">
                <Fluent:RibbonGroupBox Header="Quality Assurance">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="RRC" Tag="RRC">
                <Fluent:RibbonGroupBox Header="RRC Workspace">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="Purchase" Tag="Purchase">
                <Fluent:RibbonGroupBox Header="Purchasing">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="Shipping" Tag="Shipping">
                <Fluent:RibbonGroupBox Header="Shipping Workspace">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="Warehouse" Tag="Warehouse">
                <Fluent:RibbonGroupBox Header="Warehouse Workspace">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="Production" Tag="Production">
                <Fluent:RibbonGroupBox Header="Production Workspace">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
            <Fluent:RibbonTabItem Header="Tools &amp; Settings" Tag="Settings">
                <Fluent:RibbonGroupBox Header="System">
                    <Fluent:Button Header="System config" Tag="Settings:System Config" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Access">
                    <Fluent:Button Header="User accounts" Tag="Settings:Users" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Roles &amp; permissions" Tag="Settings:Roles" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="People">
                    <Fluent:Button Header="Staff directory" Tag="Settings:Staff" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Devices">
                    <Fluent:Button Header="Hardware scales" Tag="Settings:Scales" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Printers" Tag="Settings:Printer" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Data">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button x:Name="ExportCsvButton" Header="Export CSV" Tag="Export" IsEnabled="False"
                                   Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="WorkspaceHost" />
        </ScrollViewer>

        <Border Grid.Row="3" Background="White" BorderBrush="#E1E7EF" BorderThickness="0,1,0,0">
            <DockPanel Margin="18,0">
                <TextBlock x:Name="FooterText" Text="YTRC-ERP  |  Client 0.1.0" FontSize="11" Foreground="#68788D"
                           VerticalAlignment="Center" />
                <TextBlock Text="Desktop workspace" FontSize="11" Foreground="#68788D" VerticalAlignment="Center"
                           DockPanel.Dock="Right" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
