<Fluent:RibbonWindow x:Class="YTRC.ERP.Wpf.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                     xmlns:local="clr-namespace:YTRC.ERP.Wpf"
                     Title="YTRC-MRP" Icon="Assets/YTRC-ERP.ico" IsIconVisible="True"
                     Width="1480" Height="960" MinWidth="1120" MinHeight="720"
                     WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="{StaticResource AppFontFamily}"
                     Foreground="{StaticResource TextBrush}"
                     Closed="Window_Closed">
    <Fluent:RibbonWindow.Resources>
        <local:RibbonCommandIconConverter x:Key="RibbonCommandIconConverter" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Button.MouseOver.Background" Color="#EAF6F4" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Button.MouseOver.Border" Color="#3D9E91" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Button.Pressed.Background" Color="#D4EBE6" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Button.Pressed.Border" Color="#0F766E" />
        <ControlTemplate x:Key="Fluent.Ribbon.Templates.Button" TargetType="{x:Type Fluent:Button}">
            <Border x:Name="border" HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource AppCornerRadiusMedium}"
                    SnapsToDevicePixels="True">
                <StackPanel x:Name="stackPanel" Margin="{TemplateBinding Padding}" Orientation="Vertical">
                    <Fluent:IconPresenter x:Name="iconImage" Margin="0,2,0,0"
                                          HorizontalAlignment="Center"
                                          SmallIcon="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                          MediumIcon="{Binding MediumIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                          LargeIcon="{Binding LargeIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                          CustomSize="{Binding Path=(Fluent:RibbonProperties.CustomIconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                          IconSize="{Binding Path=(Fluent:RibbonProperties.IconSize), RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentControl x:Name="PART_HeaderContentHost" Margin="2,0,0,0"
                                    HorizontalAlignment="Center"
                                    Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" Focusable="False" />
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Size" Value="Small">
                    <Setter TargetName="PART_HeaderContentHost" Property="Margin" Value="2,0,2,0" />
                    <Setter TargetName="PART_HeaderContentHost" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="iconImage" Property="Margin" Value="0" />
                    <Setter TargetName="stackPanel" Property="Orientation" Value="Horizontal" />
                </Trigger>
                <Trigger Property="Size" Value="Middle">
                    <Setter TargetName="PART_HeaderContentHost" Property="Margin" Value="4,0,4,0" />
                    <Setter TargetName="PART_HeaderContentHost" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="border" Property="VerticalAlignment" Value="Stretch" />
                    <Setter TargetName="iconImage" Property="Margin" Value="0" />
                    <Setter TargetName="iconImage" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="stackPanel" Property="Orientation" Value="Horizontal" />
                    <Setter TargetName="stackPanel" Property="Width" Value="Auto" />
                </Trigger>
                <Trigger Property="Size" Value="Large">
                    <Setter TargetName="border" Property="MinHeight" Value="68" />
                    <Setter TargetName="PART_HeaderContentHost" Property="Margin" Value="0,1,0,0" />
                    <Setter TargetName="PART_HeaderContentHost" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="border" Property="VerticalAlignment" Value="Stretch" />
                    <Setter TargetName="iconImage" Property="Margin" Value="0,2,0,1" />
                    <Setter TargetName="iconImage" Property="HorizontalAlignment" Value="Center" />
                    <Setter TargetName="stackPanel" Property="Orientation" Value="Vertical" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(Fluent:RibbonProperties.IsElementInQuickAccessToolBar), RelativeSource={RelativeSource TemplatedParent}}"
                             Value="True">
                    <Setter TargetName="PART_HeaderContentHost" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PART_HeaderContentHost" Property="Margin" Value="6,0,4,0" />
                    <Setter TargetName="PART_HeaderContentHost" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="iconImage" Property="Margin" Value="0" />
                    <Setter TargetName="iconImage" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="stackPanel" Property="Orientation" Value="Horizontal" />
                    <Setter TargetName="stackPanel" Property="Width" Value="Auto" />
                </DataTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.Pressed.Background}" />
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.Pressed.Border}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="PART_HeaderContentHost" Property="Opacity" Value="0.5" />
                    <Setter TargetName="iconImage" Property="Opacity" Value="0.45" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsPressed" Value="False" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.MouseOver.Background}" />
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.MouseOver.Border}" />
                    <Setter TargetName="PART_HeaderContentHost" Property="Foreground" Value="#0F766E" />
                    <Setter TargetName="PART_HeaderContentHost" Property="FontWeight" Value="SemiBold" />
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="{x:Type Fluent:RibbonTabItem}">
            <Setter Property="ActiveTabBorderBrush" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <DataTemplate x:Key="RibbonTabHeaderTemplate">
            <Grid x:Name="TabGrid" Margin="3,0" Cursor="Hand" SnapsToDevicePixels="True" VerticalAlignment="Stretch">
                <Border x:Name="TabHoverPill" CornerRadius="4" Background="Transparent"
                        Padding="12,6,12,7" VerticalAlignment="Center">
                    <TextBlock x:Name="TabHeaderText" Text="{Binding}"
                               FontFamily="{StaticResource AppFontFamily}" FontSize="13"
                               FontWeight="Normal" Foreground="#475569"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <!-- Single elegant active indicator bar centered under the text -->
                <Border x:Name="TabActiveBar" Height="3" CornerRadius="1.5" Background="Transparent"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Width="{Binding ActualWidth, ElementName=TabHeaderText}"
                        Margin="0,0,0,0" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Fluent:RibbonTabItem}}}" Value="True">
                    <Setter TargetName="TabHoverPill" Property="Background" Value="#F0FDFA" />
                    <Setter TargetName="TabHeaderText" Property="Foreground" Value="#0F766E" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type Fluent:RibbonTabItem}}}" Value="True">
                    <Setter TargetName="TabHeaderText" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="TabHeaderText" Property="Foreground" Value="#0F766E" />
                    <Setter TargetName="TabActiveBar" Property="Background" Value="#0F766E" />
                    <Setter TargetName="TabHoverPill" Property="Background" Value="Transparent" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="RibbonGroupHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <DataTemplate x:Key="RibbonCommandHeaderTemplate">
            <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Fluent:Button}}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Fluent:Button}}}" Value="True">
                                <Setter Property="Foreground" Value="#0F766E" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="RibbonCenteredCommandHeaderTemplate">
            <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Fluent:Button}}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Fluent:Button}}}" Value="True">
                                <Setter Property="Foreground" Value="#0F766E" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="RibbonTwoLineCommandHeaderTemplate">
            <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" TextWrapping="Wrap"
                       FontSize="11.5"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="84">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Fluent:Button}}}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Fluent:Button}}}" Value="True">
                                <Setter Property="Foreground" Value="#0F766E" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DataTemplate>
        <DataTemplate x:Key="RibbonDropDownCommandHeaderTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Fluent:DropDownButton}}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type Fluent:DropDownButton}}}" Value="True">
                                <Setter Property="Foreground" Value="#0F766E" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <icons:FluentIcon Icon="ChevronDown" IconSize="Size12" IconVariant="Regular"
                              FontSize="12" Width="12" Height="12" Foreground="#0F766E"
                              HorizontalAlignment="Center" Margin="0,1,0,0" />
        </StackPanel>
    </DataTemplate>
    <Style TargetType="{x:Type Fluent:Button}">
        <Setter Property="Template" Value="{StaticResource Fluent.Ribbon.Templates.Button}" />
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeaderTemplate" Value="{StaticResource RibbonCommandHeaderTemplate}" />
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Margin" Value="1,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SizeDefinition" Value="Middle,Middle,Middle" />
        <Setter Property="Fluent:RibbonProperties.MouseOverBackground" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.MouseOver.Background}" />
        <Setter Property="Fluent:RibbonProperties.MouseOverForeground" Value="#0F766E" />
        <Setter Property="Icon">
            <Setter.Value>
                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                         Converter="{StaticResource RibbonCommandIconConverter}" />
            </Setter.Value>
        </Setter>
        <Setter Property="LargeIcon">
            <Setter.Value>
                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                         Converter="{StaticResource RibbonCommandIconConverter}" ConverterParameter="Large" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Fluent:DropDownButton}">
        <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="HeaderTemplate" Value="{StaticResource RibbonDropDownCommandHeaderTemplate}" />
        <Setter Property="SizeDefinition" Value="Large,Large,Large" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Fluent:RibbonProperties.CornerRadius" Value="{StaticResource AppCornerRadiusMedium}" />
        <Setter Property="Fluent:RibbonProperties.MouseOverBackground" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.MouseOver.Background}" />
        <Setter Property="Fluent:RibbonProperties.MouseOverForeground" Value="#0F766E" />
        <Setter Property="Icon">
            <Setter.Value>
                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                         Converter="{StaticResource RibbonCommandIconConverter}" />
            </Setter.Value>
        </Setter>
        <Setter Property="LargeIcon">
            <Setter.Value>
                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                         Converter="{StaticResource RibbonCommandIconConverter}" ConverterParameter="Large" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="{x:Type Fluent:MenuItem}">
        <Setter Property="Fluent:RibbonProperties.CornerRadius" Value="{StaticResource AppCornerRadiusMedium}" />
        <Setter Property="Fluent:RibbonProperties.MouseOverBackground" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.MouseOver.Background}" />
        <Setter Property="Fluent:RibbonProperties.MouseOverForeground" Value="#0F766E" />
        <Setter Property="Icon">
            <Setter.Value>
                <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                         Converter="{StaticResource RibbonCommandIconConverter}" />
            </Setter.Value>
        </Setter>
    </Style>
    </Fluent:RibbonWindow.Resources>

    <Grid x:Name="MainLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Fluent:Ribbon x:Name="MainRibbon" Grid.Row="0" SelectedTabChanged="MainRibbon_SelectedTabChanged"
                       ShowQuickAccessToolBarAboveRibbon="False" IsQuickAccessToolBarVisible="False"
                       IsQuickAccessToolBarMenuDropDownVisible="False"
                       CanCustomizeQuickAccessToolBar="False" CanCustomizeQuickAccessToolBarItems="False"
                       CanMinimize="True" ContentHeight="120">
<Fluent:Ribbon.ToolBarItems>
                <Fluent:Button Header="Help" Tag="Help" ToolTip="Help and about YTRC-MRP"
                               Width="62" MinWidth="62" Height="28" Padding="2,2" Margin="0"
                               SizeDefinition="Middle,Middle,Middle"
                               Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               Click="HelpButton_Click" />
            </Fluent:Ribbon.ToolBarItems>

            <Fluent:RibbonTabItem Header="Home" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Home">
                <Fluent:RibbonGroupBox>
                    <StackPanel>
                        <TextBlock Text="Workspace" Style="{StaticResource RibbonGroupHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <Fluent:Button Header="Overview&#x0a;Dashboard" Tag="Dashboard"
                                           SizeDefinition="Large,Large,Large" Width="76"
                                           HeaderTemplate="{StaticResource RibbonTwoLineCommandHeaderTemplate}"
                                           Click="RibbonAction_Click"
                                           ToolTip="Return to the main YTRC-MRP workspace dashboard" />
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <Fluent:Button Header="Reload Data" Tag="Refresh"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="112"
                                               Click="RibbonAction_Click"
                                               ToolTip="Reload the current dashboard and connected records" />
                                <Fluent:Button Header="Auto Fit Grid" Tag="AutoFitColumns"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="112"
                                               Click="RibbonAction_Click"
                                               ToolTip="Adjust active data table columns to optimal width" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox>
                    <StackPanel>
                        <TextBlock Text="Quick Actions" Style="{StaticResource RibbonGroupHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <Fluent:Button Header="New&#x0a;Request" Tag="New"
                                           SizeDefinition="Large,Large,Large" Width="72"
                                           HeaderTemplate="{StaticResource RibbonTwoLineCommandHeaderTemplate}"
                                           IsEnabled="False" Click="RibbonAction_Click"
                                           ToolTip="Create a new ERP business workflow transaction" />
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <Fluent:Button Header="Export Data" Tag="Export"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="112"
                                               Click="RibbonAction_Click"
                                               ToolTip="Export visible table rows to CSV spreadsheet" />
                                <Fluent:Button Header="Reports" Tag="Reports"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="112"
                                               IsEnabled="False" Click="RibbonAction_Click"
                                               ToolTip="Generate operational and managerial reports" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox IsLauncherVisible="True"
                                        LauncherToolTip="Focus the work area search field"
                                        LauncherClick="SearchGroupLauncher_Click">
                    <StackPanel>
                        <TextBlock Text="Find Work Area" Style="{StaticResource RibbonGroupHeading}" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                            <TextBox x:Name="SearchBox" Width="210" Height="28" Padding="7,4"
                                     ToolTip="Search departments and work areas" KeyDown="SearchBox_KeyDown" />
                            <Fluent:Button Header="Search" Tag="Search" Margin="6,0,0,0" Height="28" MinWidth="75"
                                           SizeDefinition="Middle,Middle,Middle"
                                           Click="RibbonAction_Click">
                                <Fluent:Button.ToolTip>
                                    <Fluent:ScreenTip Title="Search work areas" Text="Find departments and supported work areas by name or workflow." />
                                </Fluent:Button.ToolTip>
                            </Fluent:Button>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Purchasing" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Purchase">
                <Fluent:RibbonGroupBox>
                    <StackPanel>
                        <TextBlock Text="Cuplump Queue" Style="{StaticResource RibbonGroupHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <Fluent:Button Header="Cuplump&#x0a;Bookings" Tag="PurchasingAction:Cuplump:ManageBookings"
                                           SizeDefinition="Large,Large,Large" Width="76"
                                           HeaderTemplate="{StaticResource RibbonTwoLineCommandHeaderTemplate}"
                                           Click="PurchasingMenuItem_Click"
                                           ToolTip="Manage Cuplump queue slots and supplier bookings" />
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <Fluent:Button Header="Dashboard" Tag="PurchasingAction:Cuplump:Dashboard"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="130"
                                               Click="PurchasingMenuItem_Click"
                                               ToolTip="View Cuplump booking and lot activity" />
                                <Fluent:Button Header="Refresh Queue" Tag="Refresh"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="130"
                                               Click="RibbonAction_Click"
                                               ToolTip="Reload Cuplump booking queue records" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox>
                    <StackPanel>
                        <TextBlock Text="USS Queue" Style="{StaticResource RibbonGroupHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <Fluent:Button Header="USS&#x0a;Bookings" Tag="PurchasingAction:USS:ManageBookings"
                                           SizeDefinition="Large,Large,Large" Width="76"
                                           HeaderTemplate="{StaticResource RibbonTwoLineCommandHeaderTemplate}"
                                           Click="PurchasingMenuItem_Click"
                                           ToolTip="Manage USS queue slots and supplier bookings" />
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <Fluent:Button Header="Dashboard" Tag="PurchasingAction:USS:Dashboard"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="130"
                                               Click="PurchasingMenuItem_Click"
                                               ToolTip="View USS booking, slot, and weight activity" />
                                <Fluent:Button Header="Marking Prep" Tag="Purchasing:Marking Preparation"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="130"
                                               Click="RibbonAction_Click"
                                               ToolTip="Preparation of rubber lot marking and tags" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox>
                    <StackPanel>
                        <TextBlock Text="Master Data" Style="{StaticResource RibbonGroupHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <Fluent:Button Header="Manage&#x0a;Suppliers" Tag="PurchasingAction:Supplier:ManageSuppliers"
                                           SizeDefinition="Large,Large,Large" Width="76"
                                           HeaderTemplate="{StaticResource RibbonTwoLineCommandHeaderTemplate}"
                                           Click="PurchasingMenuItem_Click"
                                           ToolTip="Manage supplier profiles and registrations" />
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <Fluent:Button Header="Suppliers Summary" Tag="PurchasingAction:Supplier:SuppliersSummary"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="132"
                                               Click="PurchasingMenuItem_Click"
                                               ToolTip="Detailed summary of suppliers" />
                                <Fluent:Button Header="Rubber Types" Tag="PurchasingAction:Rubber Type:ManageRubberTypes"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="132"
                                               Click="PurchasingMenuItem_Click"
                                               ToolTip="Manage rubber raw material categories" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>

                <Fluent:RibbonGroupBox>
                    <StackPanel>
                        <TextBlock Text="Orders &amp; Grid" Style="{StaticResource RibbonGroupHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <Fluent:Button Header="Purchase&#x0a;Orders" Tag="PurchasingAction:Order:ManageOrders"
                                           SizeDefinition="Large,Large,Large" Width="76"
                                           HeaderTemplate="{StaticResource RibbonTwoLineCommandHeaderTemplate}"
                                           Click="PurchasingMenuItem_Click"
                                           ToolTip="Manage purchase contracts and orders" />
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <Fluent:Button Header="Orders Summary" Tag="PurchasingAction:Order:OrdersSummary"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="120"
                                               Click="PurchasingMenuItem_Click"
                                               ToolTip="View purchase order summary and status" />
                                <Fluent:Button Header="Auto Fit Grid" Tag="AutoFitColumns"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="120"
                                               Click="RibbonAction_Click"
                                               ToolTip="Adjust active data table columns to optimal width" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="RRC" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Receiving">
                <Fluent:RibbonGroupBox>
                    <StackPanel>
                        <TextBlock Text="Inbound Receiving" Style="{StaticResource RibbonGroupHeading}" />
                        <StackPanel Orientation="Horizontal">
                            <Fluent:Button Header="Cuplump&#x0a;Receiving" Tag="RRC:Cuplump:Receiving"
                                           SizeDefinition="Large,Large,Large" Width="76"
                                           HeaderTemplate="{StaticResource RibbonTwoLineCommandHeaderTemplate}"
                                           Click="RibbonAction_Click"
                                           ToolTip="Open raw rubber receiving operations" />
                            <StackPanel Margin="4,0,0,0" VerticalAlignment="Center">
                                <Fluent:Button Header="Queue Summary" Tag="RRC:Cuplump:QueueSummary"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="125"
                                               Click="RibbonAction_Click"
                                               ToolTip="View receiving queue summary and inspection status" />
                                <Fluent:Button Header="Refresh Inbound" Tag="Refresh"
                                               SizeDefinition="Middle,Middle,Middle" Height="26" MinHeight="26" MinWidth="125"
                                               Click="RibbonAction_Click"
                                               ToolTip="Reload receiving queue and lot arrivals" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
