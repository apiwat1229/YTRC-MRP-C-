<Fluent:RibbonWindow x:Class="YTRC.ERP.Wpf.MainWindow"
                     xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                     xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                     xmlns:Fluent="urn:fluent-ribbon"
                     xmlns:icons="clr-namespace:FluentIcons.Wpf;assembly=FluentIcons.Wpf"
                     xmlns:local="clr-namespace:YTRC.ERP.Wpf"
                     Title="YTRC-MRP" Icon="Assets/YTRC-ERP.ico" IsIconVisible="True"
                     Width="1480" Height="960" MinWidth="1120" MinHeight="720"
                     WindowStartupLocation="CenterScreen" Background="#F5F7FA" FontFamily="{StaticResource AppFontFamily}"
                     Closed="Window_Closed">
    <Fluent:RibbonWindow.Resources>
        <local:RibbonTabIconConverter x:Key="RibbonTabIconConverter" />
        <local:RibbonTabIconColorConverter x:Key="RibbonTabIconColorConverter" />
        <local:RibbonCommandIconConverter x:Key="RibbonCommandIconConverter" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Button.MouseOver.Background" Color="#EAF4F2" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Button.MouseOver.Border" Color="#C4DCD6" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Button.Pressed.Background" Color="#DDEDE9" />
        <SolidColorBrush x:Key="Fluent.Ribbon.Brushes.Button.Pressed.Border" Color="#B7D5CF" />
        <ControlTemplate x:Key="Fluent.Ribbon.Templates.Button" TargetType="{x:Type Fluent:Button}">
            <Border x:Name="border" HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalAlignment}" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{StaticResource AppCornerRadius}">
                <StackPanel x:Name="stackPanel" Margin="{TemplateBinding Padding}" Orientation="Vertical">
                    <Fluent:IconPresenter x:Name="iconImage" Margin="0,2,0,0"
                                          SmallIcon="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}}"
                                          MediumIcon="{Binding MediumIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                          LargeIcon="{Binding LargeIcon, RelativeSource={RelativeSource TemplatedParent}}"
                                          CustomSize="{Binding Path=(Fluent:RibbonProperties.CustomIconSize), RelativeSource={RelativeSource TemplatedParent}}"
                                          IconSize="{Binding Path=(Fluent:RibbonProperties.IconSize), RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentControl x:Name="PART_HeaderContentHost" Margin="2,0,0,0"
                                    Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}" Focusable="False" />
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="Size" Value="Small">
                    <Setter TargetName="PART_HeaderContentHost" Property="Margin" Value="2,0,2,0" />
                    <Setter TargetName="PART_HeaderContentHost" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="iconImage" Property="Margin" Value="0" />
                    <Setter TargetName="stackPanel" Property="Orientation" Value="Horizontal" />
                </Trigger>
                <Trigger Property="Size" Value="Middle">
                    <Setter TargetName="PART_HeaderContentHost" Property="Margin" Value="2,0,2,0" />
                    <Setter TargetName="PART_HeaderContentHost" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="border" Property="VerticalAlignment" Value="Stretch" />
                    <Setter TargetName="iconImage" Property="Margin" Value="0" />
                    <Setter TargetName="iconImage" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="stackPanel" Property="Orientation" Value="Horizontal" />
                    <Setter TargetName="stackPanel" Property="Width" Value="Auto" />
                </Trigger>
                <DataTrigger Binding="{Binding Path=(Fluent:RibbonProperties.IsElementInQuickAccessToolBar), RelativeSource={RelativeSource TemplatedParent}}"
                             Value="True">
                    <Setter TargetName="PART_HeaderContentHost" Property="Visibility" Value="Visible" />
                    <Setter TargetName="PART_HeaderContentHost" Property="Margin" Value="6,0,4,0" />
                    <Setter TargetName="PART_HeaderContentHost" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="iconImage" Property="Margin" Value="0" />
                    <Setter TargetName="iconImage" Property="VerticalAlignment" Value="Center" />
                    <Setter TargetName="stackPanel" Property="Orientation" Value="Horizontal" />
                    <Setter TargetName="stackPanel" Property="Width" Value="Auto" />
                </DataTrigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.Pressed.Background}" />
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.Pressed.Border}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="PART_HeaderContentHost" Property="Opacity" Value="0.5" />
                </Trigger>
                <MultiTrigger>
                    <MultiTrigger.Conditions>
                        <Condition Property="IsMouseOver" Value="True" />
                        <Condition Property="IsPressed" Value="False" />
                        <Condition Property="IsEnabled" Value="True" />
                    </MultiTrigger.Conditions>
                    <Setter TargetName="border" Property="Background" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.MouseOver.Background}" />
                    <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource Fluent.Ribbon.Brushes.Button.MouseOver.Border}" />
                </MultiTrigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <DataTemplate x:Key="RibbonTabHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <icons:FluentIcon Icon="{Binding Converter={StaticResource RibbonTabIconConverter}}"
                                  IconSize="Size16" IconVariant="Regular" FontSize="16" Width="16" Height="16"
                                  Foreground="{Binding Converter={StaticResource RibbonTabIconColorConverter}}"
                                  VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="RibbonCommandHeaderTemplate">
            <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="RibbonCenteredCommandHeaderTemplate">
            <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" TextWrapping="NoWrap"
                       TextTrimming="CharacterEllipsis" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </DataTemplate>
        <DataTemplate x:Key="RibbonTwoLineCommandHeaderTemplate">
            <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" TextWrapping="Wrap"
                       TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"
                       MaxWidth="90" />
        </DataTemplate>
        <DataTemplate x:Key="RibbonDropDownCommandHeaderTemplate">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding}" FontFamily="{StaticResource AppFontFamily}" TextWrapping="NoWrap"
                           TextTrimming="CharacterEllipsis" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <icons:FluentIcon Icon="ChevronDown" IconSize="Size12" IconVariant="Regular"
                                  FontSize="12" Width="12" Height="12" Foreground="#0F766E"
                                  HorizontalAlignment="Center" Margin="0,1,0,0" />
            </StackPanel>
        </DataTemplate>
        <Style TargetType="{x:Type Fluent:Button}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HeaderTemplate" Value="{StaticResource RibbonCommandHeaderTemplate}" />
            <Setter Property="MinWidth" Value="88" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="SizeDefinition" Value="Middle,Middle,Middle" />
            <Setter Property="Fluent:RibbonProperties.MouseOverBackground" Value="#EAF4F2" />
            <Setter Property="Fluent:RibbonProperties.MouseOverForeground" Value="#36534E" />
            <Setter Property="Icon">
                <Setter.Value>
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                             Converter="{StaticResource RibbonCommandIconConverter}" />
                </Setter.Value>
            </Setter>
            <Setter Property="LargeIcon">
                <Setter.Value>
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                             Converter="{StaticResource RibbonCommandIconConverter}" ConverterParameter="Large" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Fluent:DropDownButton}">
            <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HeaderTemplate" Value="{StaticResource RibbonDropDownCommandHeaderTemplate}" />
            <Setter Property="SizeDefinition" Value="Large,Large,Large" />
            <Setter Property="Fluent:RibbonProperties.CornerRadius" Value="{StaticResource AppCornerRadius}" />
            <Setter Property="Fluent:RibbonProperties.MouseOverBackground" Value="#EAF4F2" />
            <Setter Property="Fluent:RibbonProperties.MouseOverForeground" Value="#36534E" />
            <Setter Property="LargeIcon">
                <Setter.Value>
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                             Converter="{StaticResource RibbonCommandIconConverter}" ConverterParameter="Large" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="{x:Type Fluent:MenuItem}">
            <Setter Property="Fluent:RibbonProperties.CornerRadius" Value="{StaticResource AppCornerRadius}" />
            <Setter Property="Fluent:RibbonProperties.MouseOverBackground" Value="#EAF4F2" />
            <Setter Property="Fluent:RibbonProperties.MouseOverForeground" Value="#36534E" />
            <Setter Property="Icon">
                <Setter.Value>
                    <Binding Path="Tag" RelativeSource="{RelativeSource Self}"
                             Converter="{StaticResource RibbonCommandIconConverter}" />
                </Setter.Value>
            </Setter>
        </Style>
    </Fluent:RibbonWindow.Resources>

    <Grid x:Name="MainLayoutGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="38" />
        </Grid.RowDefinitions>

        <Fluent:Ribbon x:Name="MainRibbon" Grid.Row="0" SelectedTabChanged="MainRibbon_SelectedTabChanged"
                       ShowQuickAccessToolBarAboveRibbon="False" IsQuickAccessToolBarVisible="False"
                       IsQuickAccessToolBarMenuDropDownVisible="False"
                       CanCustomizeQuickAccessToolBar="False" CanCustomizeQuickAccessToolBarItems="False"
                       CanMinimize="True" ContentHeight="96">
            <Fluent:Ribbon.ContextualGroups>
                <Fluent:RibbonContextualTabGroup x:Name="DataToolsGroup" Header="Data Tools"
                                                  Background="#0F766E" BorderBrush="#0F766E"
                                                  TabItemForeground="White" Visibility="Collapsed" />
            </Fluent:Ribbon.ContextualGroups>
<Fluent:Ribbon.ToolBarItems>
                <Fluent:Button Header="Help" Tag="Help" ToolTip="Help and about YTRC-MRP"
                               Width="62" MinWidth="62" Height="28" Padding="2,2" Margin="0"
                               SizeDefinition="Middle,Middle,Middle"
                               Background="Transparent" BorderBrush="Transparent" BorderThickness="1"
                               HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                               Click="HelpButton_Click" />
            </Fluent:Ribbon.ToolBarItems>

            <Fluent:RibbonTabItem Header="Home" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Home">
                <Fluent:RibbonGroupBox Header="Workspace">
                    <Fluent:Button Header="Dashboard" Tag="Dashboard" Width="112" MinWidth="112"
                                   SizeDefinition="Middle,Middle,Middle" Click="RibbonAction_Click">
                        <Fluent:Button.ToolTip>
                            <Fluent:ScreenTip Title="Dashboard" Text="Return to the YTRC-MRP home workspace." />
                        </Fluent:Button.ToolTip>
                    </Fluent:Button>
                    <Fluent:Button Header="Refresh" Tag="Refresh" Width="112" MinWidth="112"
                                   SizeDefinition="Middle,Middle,Middle" Click="RibbonAction_Click">
                        <Fluent:Button.ToolTip>
                            <Fluent:ScreenTip Title="Refresh" Text="Reload the current dashboard or connected records." />
                        </Fluent:Button.ToolTip>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Quick actions">
                    <Fluent:Button Header="New request" Tag="New" Width="106" SizeDefinition="Large,Large,Large"
                                   IsEnabled="False" Click="RibbonAction_Click">
                        <Fluent:Button.ToolTip>
                            <Fluent:ScreenTip Title="New request" Text="Transaction creation becomes available when the ERP workflow API is connected." />
                        </Fluent:Button.ToolTip>
                    </Fluent:Button>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Insights">
                    <Fluent:Button Header="Reports" Tag="Reports" Click="RibbonAction_Click" IsEnabled="False" />
                    <Fluent:Button Header="Export" Tag="Export" Click="RibbonAction_Click" IsEnabled="False" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Find" IsLauncherVisible="True"
                                        LauncherToolTip="Focus the work area search field"
                                        LauncherClick="SearchGroupLauncher_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Width="220" Height="28" Padding="7,4"
                                 ToolTip="Search departments and work areas" KeyDown="SearchBox_KeyDown" />
                        <Fluent:Button Header="Search" Tag="Search" Margin="5,0,0,0"
                                       Click="RibbonAction_Click">
                            <Fluent:Button.ToolTip>
                                <Fluent:ScreenTip Title="Search work areas" Text="Find departments and supported work areas by name or workflow." />
                            </Fluent:Button.ToolTip>
                        </Fluent:Button>
                    </StackPanel>
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Purchasing" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Purchase">
                <Fluent:RibbonGroupBox x:Name="PurchaseOrderActionsGroup" Header="Purchase orders">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox x:Name="PurchaseReportingGroup" Header="Reporting">
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox x:Name="PurchasingBookingQueueGroup" Header="Booking Queue">
                    <Fluent:DropDownButton Header="Cuplump" Tag="Purchasing:Cuplump" Width="74" MinWidth="74"
                                           HasTriangle="False" SizeDefinition="Large,Large,Large"
                                           Loaded="PurchasingDropDown_Loaded"
                                           DropDownOpened="PurchasingDropDown_Opened">
                        <Fluent:MenuItem Header="Create Booking" Tag="PurchasingAction:Cuplump:CreateBooking" Click="PurchasingMenuItem_Click" />
                        <Fluent:MenuItem Header="Manage Bookings" Tag="PurchasingAction:Cuplump:ManageBookings" Click="PurchasingMenuItem_Click" />
                        <Separator />
                        <Fluent:MenuItem Header="Daily Summary" Tag="PurchasingAction:Cuplump:DailySummary" Click="PurchasingMenuItem_Click" />
                    </Fluent:DropDownButton>
                    <Fluent:DropDownButton Header="USS" Tag="Purchasing:USS" Width="64" MinWidth="64"
                                           HasTriangle="False" SizeDefinition="Large,Large,Large"
                                           Loaded="PurchasingDropDown_Loaded"
                                           DropDownOpened="PurchasingDropDown_Opened">
                        <Fluent:MenuItem Header="Create Booking" Tag="PurchasingAction:USS:CreateBooking" Click="PurchasingMenuItem_Click" />
                        <Fluent:MenuItem Header="Manage Bookings" Tag="PurchasingAction:USS:ManageBookings" Click="PurchasingMenuItem_Click" />
                        <Separator />
                        <Fluent:MenuItem Header="Daily Summary" Tag="PurchasingAction:USS:DailySummary" Click="PurchasingMenuItem_Click" />
                    </Fluent:DropDownButton>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox x:Name="PurchasingMasterDataGroup" Header="Master data">
                    <Fluent:DropDownButton Header="Supplier" Tag="Purchasing:Supplier" Width="76" MinWidth="76"
                                           HasTriangle="False" SizeDefinition="Large,Large,Large"
                                           Loaded="PurchasingDropDown_Loaded"
                                           DropDownOpened="PurchasingDropDown_Opened">
                        <Fluent:MenuItem Header="Add Supplier" Tag="PurchasingAction:Supplier:AddSupplier" Click="PurchasingMenuItem_Click" />
                        <Fluent:MenuItem Header="Manage Suppliers" Tag="PurchasingAction:Supplier:ManageSuppliers" Click="PurchasingMenuItem_Click" />
                        <Separator />
                        <Fluent:MenuItem Header="Suppliers Summary" Tag="PurchasingAction:Supplier:SuppliersSummary" Click="PurchasingMenuItem_Click" />
                    </Fluent:DropDownButton>
                    <Fluent:DropDownButton Header="Rubber Type" Tag="Purchasing:Rubber Type" Width="96" MinWidth="96"
                                           HasTriangle="False" SizeDefinition="Large,Large,Large"
                                           Loaded="PurchasingDropDown_Loaded"
                                           DropDownOpened="PurchasingDropDown_Opened">
                        <Fluent:MenuItem Header="Add Rubber Type" Tag="PurchasingAction:Rubber Type:AddRubberType" Click="PurchasingMenuItem_Click" />
                        <Fluent:MenuItem Header="Manage Rubber Types" Tag="PurchasingAction:Rubber Type:ManageRubberTypes" Click="PurchasingMenuItem_Click" />
                        <Separator />
                        <Fluent:MenuItem Header="Types Summary" Tag="PurchasingAction:Rubber Type:TypesSummary" Click="PurchasingMenuItem_Click" />
                    </Fluent:DropDownButton>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox x:Name="PurchasingOrdersGroup" Header="Orders">
                    <Fluent:DropDownButton Header="Order" Tag="Purchasing:Order" Width="72" MinWidth="72"
                                           HasTriangle="False" SizeDefinition="Large,Large,Large"
                                           Loaded="PurchasingDropDown_Loaded"
                                           DropDownOpened="PurchasingDropDown_Opened">
                        <Fluent:MenuItem Header="Create Order" Tag="PurchasingAction:Order:CreateOrder" Click="PurchasingMenuItem_Click" />
                        <Fluent:MenuItem Header="Manage Orders" Tag="PurchasingAction:Order:ManageOrders" Click="PurchasingMenuItem_Click" />
                        <Separator />
                        <Fluent:MenuItem Header="Orders Summary" Tag="PurchasingAction:Order:OrdersSummary" Click="PurchasingMenuItem_Click" />
                    </Fluent:DropDownButton>
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Preparation">
                    <Fluent:Button Header="Marking Preparation" Tag="Purchasing:Marking Preparation"
                                   Width="108" MinWidth="108" SizeDefinition="Large,Large,Large"
                                   HeaderTemplate="{StaticResource RibbonTwoLineCommandHeaderTemplate}"
                                   Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Receiving" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Receiving">
                <Fluent:RibbonGroupBox Header="Receipts">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New receipt" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Reporting">
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Production" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Production">
                <Fluent:RibbonGroupBox Header="Work orders">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New work order" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Reporting">
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="QA" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="QA">
                <Fluent:RibbonGroupBox Header="Quality assurance">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Reporting">
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Warehouse" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Warehouse">
                <Fluent:RibbonGroupBox Header="Inventory">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Inventory" Tag="Inventory" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Reporting">
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Maintenance" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Maintenance">
                <Fluent:RibbonGroupBox Header="Maintenance">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New request" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Reporting">
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="IT" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="IT">
                <Fluent:RibbonGroupBox Header="IT support">
                    <Fluent:Button Header="Refresh" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button Header="New ticket" Tag="New" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Reporting">
                    <Fluent:Button Header="Reports" Tag="Reports" IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Settings" HeaderTemplate="{StaticResource RibbonTabHeaderTemplate}" Tag="Settings">
                <Fluent:RibbonGroupBox Header="System">
                    <Fluent:Button Header="System Config" Tag="Settings:System Config" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Access control">
                    <Fluent:Button Header="Users" Tag="Settings:Users" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Roles" Tag="Settings:Roles" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Staff" Tag="Settings:Staff" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Devices">
                    <Fluent:Button Header="Scales" Tag="Settings:Scales" Click="RibbonAction_Click" />
                    <Fluent:Button Header="Printers" Tag="Settings:Printer" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Account">
                    <Fluent:Button Header="Sign out" Tag="SignOut" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
                <Fluent:RibbonGroupBox Header="Connection">
                    <TextBlock x:Name="SettingsConnectionText" Text="API status unknown"
                               FontSize="12" Foreground="#0F766E" VerticalAlignment="Center"
                               Margin="8,0" TextWrapping="Wrap" MaxWidth="190" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Records" Group="{Binding Source={x:Reference DataToolsGroup}}">
                <Fluent:RibbonGroupBox Header="Data">
                    <Fluent:Button Header="Refresh records" Tag="Refresh" Click="RibbonAction_Click" />
                    <Fluent:Button x:Name="ExportCsvButton" Header="Export CSV" Tag="Export"
                                   IsEnabled="False" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>

            <Fluent:RibbonTabItem Header="Layout" Group="{Binding Source={x:Reference DataToolsGroup}}">
                <Fluent:RibbonGroupBox Header="Table view">
                    <Fluent:Button Header="Auto fit columns" Tag="AutoFitColumns" Click="RibbonAction_Click" />
                </Fluent:RibbonGroupBox>
            </Fluent:RibbonTabItem>
        </Fluent:Ribbon>

        <ScrollViewer x:Name="WorkspaceScrollViewer" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ContentControl x:Name="WorkspaceHost" />
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E1E7EF" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FooterText" Text="YTRC-MRP  |  Client 0.1.0" FontSize="11" Foreground="#68788D"
                           VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UserNameText" Text="Guest" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Right" />
                        <TextBlock x:Name="RoleText" Text="Guest" FontSize="10" Foreground="#68788D" HorizontalAlignment="Right" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Fluent:RibbonWindow>
