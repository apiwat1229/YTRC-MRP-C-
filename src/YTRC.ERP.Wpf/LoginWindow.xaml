<Window x:Class="YTRC.ERP.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in | YTRC-ERP" Icon="Assets/YTRC-ERP.ico" Width="440" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Grid Margin="0">
        <Border Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="14"
                Padding="32" VerticalAlignment="Stretch">
            <StackPanel VerticalAlignment="Center" Margin="0,0,0,30">
                <Grid Margin="0,0,0,26">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="40" Height="40" CornerRadius="12" Background="#0F766E">
                            <TextBlock Text="Y" Foreground="White" FontSize="22" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="YTRC-ERP" FontSize="19" FontWeight="SemiBold" Foreground="#1E2D3E" />
                            <TextBlock Text="Department operations workspace" FontSize="12" Foreground="#68788D" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="32" Height="32" Padding="0"
                            Background="Transparent" BorderBrush="Transparent" Foreground="#68788D"
                            FontSize="22" ToolTip="Close" Click="Close_Click" VerticalAlignment="Top" />
                </Grid>
                <TextBlock Text="Sign in" FontSize="28" FontWeight="SemiBold" Foreground="#1E2D3E" />
                <TextBlock Text="Sign in with your YTRC-ERP account to continue." FontSize="14" Foreground="#68788D" Margin="0,5,0,20" />

                <TextBlock Text="Username or email" FontWeight="SemiBold" Margin="0,0,0,7" />
                <TextBox x:Name="UsernameBox" Margin="0,0,0,15" />
                <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,7" />
                <Grid Margin="0,0,0,12">
                    <PasswordBox x:Name="PasswordBox" FontFamily="Segoe UI" FontSize="13" Padding="10,8,60,8"
                                 BorderBrush="#D8E0EA" BorderThickness="1"
                                 PasswordChanged="PasswordBox_PasswordChanged" />
                    <TextBox x:Name="PasswordTextBox" Padding="10,8,60,8" Visibility="Collapsed"
                             TextChanged="PasswordTextBox_TextChanged" />
                    <Button x:Name="PasswordVisibilityButton" Content="Show" Width="52" Height="30"
                            Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0" Background="White" BorderBrush="Transparent"
                            BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                            FontSize="11" FontWeight="SemiBold" Focusable="False"
                            ToolTip="Show password" Click="PasswordVisibility_Click" />
                </Grid>

                <CheckBox x:Name="RememberBox" Content="Remember username on this device" IsChecked="True"
                          Foreground="#53657A" Margin="0,0,0,15" />
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#68788D" MinHeight="24" Margin="0,0,0,12" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}"
                            Height="46" Margin="0,0,6,0" IsDefault="True" Click="SignIn_Click" />
                    <Button Grid.Column="1" Content="Cancel" Height="46" Margin="6,0,0,0"
                            Click="Close_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
