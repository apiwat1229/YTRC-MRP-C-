<Window x:Class="YTRC.ERP.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in | YTRC-MRP" Icon="Assets/YTRC-ERP.ico" Width="440" Height="520"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">
    <Grid Margin="0">
        <Border Background="White" BorderBrush="#E1E7EF" BorderThickness="1" CornerRadius="{StaticResource AppCornerRadius}"
                Padding="32,26,32,24" VerticalAlignment="Stretch">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Border Width="36" Height="36" CornerRadius="{StaticResource AppCornerRadius}" Background="#0F766E">
                            <TextBlock Text="Y" Foreground="White" FontSize="20" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="YTRC-MRP" FontSize="18" FontWeight="SemiBold" Foreground="#1E2D3E" />
                            <TextBlock Text="Department operations workspace" FontSize="12" Foreground="#68788D" />
                        </StackPanel>
                    </StackPanel>
                    <Button Grid.Column="1" Content="×" Width="28" Height="28" Padding="0"
                            Background="Transparent" BorderBrush="Transparent" Foreground="#68788D"
                            FontSize="20" ToolTip="Close" Click="Close_Click" VerticalAlignment="Top" />
                </Grid>
                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <TextBlock Text="Sign in" FontSize="26" FontWeight="SemiBold" Foreground="#1E2D3E" />
                    <TextBlock Text="Sign in with your YTRC-MRP account to continue." FontSize="13" Foreground="#68788D" Margin="0,5,0,16" />

                    <TextBlock Text="Username or email" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <TextBox x:Name="UsernameBox" Height="38" Padding="10,4" Margin="0,0,0,12" />
                    <TextBlock Text="Password" FontWeight="SemiBold" Margin="0,0,0,5" />
                    <Grid Margin="0,0,0,10">
                        <PasswordBox x:Name="PasswordBox" Height="38" FontFamily="Segoe UI" FontSize="13" Padding="10,4,60,4"
                                     BorderBrush="#D8E0EA" BorderThickness="1"
                                     PasswordChanged="PasswordBox_PasswordChanged" />
                        <TextBox x:Name="PasswordTextBox" Height="38" Padding="10,4,60,4" Visibility="Collapsed"
                                 TextChanged="PasswordTextBox_TextChanged" />
                        <Button x:Name="PasswordVisibilityButton" Content="Show" Width="52" Height="26"
                                Padding="2,0" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Margin="0,0,4,0" Background="White" BorderBrush="Transparent"
                                BorderThickness="0" Foreground="{StaticResource AccentBrush}"
                                FontSize="11" FontWeight="SemiBold" Focusable="False"
                                ToolTip="Show password" Click="PasswordVisibility_Click" />
                    </Grid>

                    <CheckBox x:Name="RememberBox" Content="Remember username on this device" IsChecked="True"
                              Foreground="#53657A" Margin="0,0,0,12" />
                    <TextBlock x:Name="StatusText" TextWrapping="Wrap" Foreground="#68788D" MinHeight="18" Margin="0,0,0,8" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SignInButton" Content="Sign in" Style="{StaticResource PrimaryButton}"
                            Height="40" Margin="0,0,6,0" IsDefault="True" Click="SignIn_Click" />
                    <Button Grid.Column="1" Content="Cancel" Height="40" Margin="6,0,0,0"
                            Click="Close_Click" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
